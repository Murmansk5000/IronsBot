# 复制此文件为 .env.dev 或 .env.prod 并填写。
# .env 文件无需手动创建，项目已内置。

# === 环境配置 ===
DRIVER=~fastapi+~httpx
HOST=127.0.0.1
PORT=8080
SUPERUSERS=[] # 可选，默认空列表，用于设置超级用户
LOG_LEVEL=INFO          # TRACE / DEBUG / INFO / WARNING / ERROR
COMMAND_START=["/", ""]
HELP_IGNORED_PLUGINS=["发图"] # 帮助列表中隐藏的插件名称；这里隐藏原作者 sendpic 示例插件

# === db_sync 插件（数据库同步控制） ===
# 默认关闭开机同步，保留定时同步。超级管理员可发送“更新数据”或“数据更新”手动同步。
DB_SYNC_ON_STARTUP=false
DB_SYNC_INTERVAL_ENABLED=true

# === seer_data 插件（数据库同步与游戏资源图片获取） ===
# 设置 SYNC_URL 后从远程自动拉取并定时更新；留空则从本地文件加载，不自动更新。
SEERAPI_SYNC_URL=https://github.com/SeerAPI/api-data/releases/download/latest/seerapi-data.sqlite
# （可选）用于校验远程同步文件是否需要更新的指纹，留空则跳过验证
SEERAPI_FINGERPRINT_URL=https://github.com/SeerAPI/api-data/releases/download/latest/seerapi-data.sqlite.sha256
SEERAPI_SYNC_INTERVAL_MINUTES=60       # 可选，默认 60，同步间隔（分钟）
SEERAPI_LOCAL_PATH=data/seerapi-data.sqlite  # 可选，本地缓存/回退路径；Docker 建议放在 /app/data
ALIAS_SYNC_URL=https://github.com/Nattsu39/ironsbot/releases/download/alias-db-latest/aliases-data.sqlite
ALIAS_FINGERPRINT_URL=https://github.com/Nattsu39/ironsbot/releases/download/alias-db-latest/aliases-data.sqlite.sha256
ALIAS_SYNC_INTERVAL_MINUTES=60         # 可选，默认 60，同步间隔（分钟）
ALIAS_LOCAL_PATH=data/aliases-data.sqlite    # 可选，本地缓存/回退路径；Docker 建议放在 /app/data

# === get_seer_info 插件 ===
RENDER_CACHE_DIR=render_cache          # 可选，图片渲染缓存目录，默认为 nonebot-plugin-localstore 插件中的缓存目录
RENDER_CACHE_MAX_SIZE_MB=200           # 可选，图片渲染缓存最大大小（MB），默认 200

# === 发图插件（以下内容仅作为示例，机器人不提供表情包/图床服务，请自行配置） ===
# 图床后端配置：CNB 图床（仅在命令后端为 cnb 时需要）
SENDPIC_CNB_TOKEN=              # CNB API 令牌
SENDPIC_CNB_REPO=Nattsu39/tudou # CNB 仓库路径

# 图床后端配置：本地文件（仅在命令后端为 local 时需要）
SENDPIC_LOCAL_ROOT=sendpic # 可选，本地图片根目录，默认为 nonebot-plugin-localstore 插件中的data_dir/sendpic目录

# 命令配置：启用哪些命令
SENDPIC_ENABLED_IDS=["tudou","pig","capoo"]

# 命令配置
SENDPIC_CONFIGS=[
    {
        "id": "tudou",
        "backend": "cnb",
        "command": "土豆",
        "aliases": ["今日土豆", "随机土豆", "🥔"],
        "image_dir": "tudou",
        "image_filename_template": "{index}.gif",
        "help_message": "土豆/今日土豆/随机土豆/🥔 <索引(可选)> — 随机或指定索引的土豆表情包",
        "message_template": "{random_text}{command}（{index}/{total}）\n🌈发【{command}x】直接出x号{command}，不加数字默认随机发送\n{image}"
    },
    {
        "id": "pig",
        "backend": "cnb",
        "command": "小猪",
        "aliases": ["今日小猪", "随机小猪", "🐷", "🐖"],
        "image_dir": "pig",
        "image_filename_template": "{index}.jpg",
        "help_message": "小猪/今日小猪/随机小猪/🐷/🐖 <索引(可选)> — 随机或指定索引的小猪表情包",
        "message_template": "{random_text}{command}（{index}/{total}）\n🌈发【{command}x】直接出x号{command}，不加数字默认随机发送\n{image}"
    },
	{
        "id": "capoo",
        "backend": "cnb",
        "command": "咖波",
        "aliases": ["今日咖波", "随机咖波", "capoo", "猫猫虫"],
        "image_dir": "capoo",
        "image_filename_template": "{index}.gif",
        "help_message": "咖波/今日咖波/随机咖波/capoo/猫猫虫 <索引(可选)> — 随机或指定索引的咖波表情包",
        "message_template": "{random_text}{command}（{index}/{total}）\n🌈发【{command}x】直接出x号{command}，不加数字默认随机发送\n{image}"
    }
]

# === 无头赛尔号客户端配置，部分功能需要登录无头客户端获取数据 ===
HEADLESS_SEER_USER_ID=12345678   # 米米号
HEADLESS_SEER_PASSWORD=...  # 密码（明文密码的MD5值）
HEADLESS_SEER_HEARTBEAT_INTERVAL=300  # 心跳间隔（秒）
HEADLESS_SEER_RECONNECT_RETRIES=-1  # 重连尝试次数，-1 表示无限重连
HEADLESS_SEER_RECONNECT_DELAY=5.0  # 重连延迟（秒）
HEADLESS_SEER_RECONNECT_DELAY_MAX=120.0  # 最大重连延迟（秒）

# === 自定义会议回复插件 ===
# 只填会议号即可自动生成链接；可用 1234567890 或 123-456-7890。
MEETING_REPLY_NUMBER=
MEETING_REPLY_TEMPLATE="腾讯会议\n腾讯会议号：{meeting_number}\n点击链接直接加入：{meeting_url}"
MEETING_REPLY_GROUPS=[]             # 允许群聊触发“开播/会议”的群号
MEETING_REPLY_USERS=[]              # 允许私聊触发“开播/会议”的用户 QQ

# === 自定义活动链接插件 ===
EVENT_LINK_TEXT=周年庆主题站签到活动：https://seerm.61.com/events/17years/#sign
EVENT_LINK_REPLY_GROUPS=[]          # 允许群聊查询“签到/活动/链接”的群号
EVENT_LINK_REPLY_USERS=[]           # 允许私聊查询“签到/活动/链接”的用户 QQ
EVENT_LINK_SEND_GROUPS=[]           # 每日定时推送活动链接的群号
EVENT_LINK_SEND_USERS=[]            # 每日定时私聊活动链接的用户 QQ
EVENT_LINK_SEND_HOUR=23
EVENT_LINK_SEND_MINUTE=0

# === 自定义 B 站动态监控插件 ===
BILIBILI_MONITOR_UID=1310714247
BILIBILI_MONITOR_DATA_DIR=data/bilibili_monitor # 保存 B 站 Cookie 与动态时间缓存；Docker 建议挂载 /app/data
BILIBILI_MONITOR_CHECK_INTERVAL_MINUTES=5
BILIBILI_MONITOR_SLEEP_START_HOUR=23
BILIBILI_MONITOR_SLEEP_END_HOUR=7
BILIBILI_MONITOR_SLEEP_INTERVAL_MINUTES=30
BILIBILI_MONITOR_TARGET_GROUP_IDS=[] # 接收 B 站动态推送的群号
BILIBILI_MONITOR_TARGET_USER_IDS=[]  # 接收 B 站动态私聊推送的用户 QQ
BILIBILI_MONITOR_ADMIN_UIDS=[]       # 可手动“更新动态”的管理员；SUPERUSERS 也会自动有权限

# === 自定义启动通知插件 ===
# 默认发送给 SUPERUSERS；STARTUP_NOTICE_USERS 可填写额外接收用户。
STARTUP_NOTICE_ENABLED=true
STARTUP_NOTICE_USERS=[]
STARTUP_NOTICE_MESSAGE=机器人已开启。
STARTUP_NOTICE_DELAY_SECONDS=3

# === 自定义定时私聊插件 ===
# 每个任务可配置多个私聊用户，同一任务会在同一时间发送同一内容。
# day_of_week 可选，留空表示每天；可填 mon-fri、sat,sun 等 APScheduler cron 写法。
SCHEDULED_PRIVATE_MESSAGES=[
    {
        "id": "morning",
        "user_ids": [123456789, 987654321],
        "hour": 8,
        "minute": 30,
        "message": "早上好"
    },
    {
        "id": "night",
        "user_ids": [123456789],
        "hour": 23,
        "minute": 0,
        "message": "该休息了"
    }
]

# === 自定义战队群快捷查询插件 ===
# 给战队群使用：群友发送“战队”时，自动查询下方配置的多个战队 ID。
# 只填示例，不要把真实群号、战队号提交到 Git；生产环境请在 .env.prod 或 Unraid 变量里填写。
TEAM_SHORTCUT_GROUP_IDS=[]       # 允许使用战队快捷查询的 QQ 战队群
TEAM_SHORTCUT_TEAM_IDS=[]        # 收到快捷指令后依次查询的战队 ID
TEAM_SHORTCUT_COMMANDS=["战队"]  # 精确匹配的战队群快捷指令
TEAM_SHORTCUT_RESOURCE_NOTICE_USER_IDS=[]  # 任一战队资源低于 1000 时要 @ 的 QQ 用户
TEAM_SHORTCUT_RESOURCE_NOTICE_MESSAGE=出来买资源，别逼我求你😡

# === AI 聊天插件（DeepSeek / OpenAI 兼容接口） ===
AI_CHAT_API_KEY=                     # DeepSeek API Key，不要提交真实密钥
AI_CHAT_BASE_URL=https://api.deepseek.com
AI_CHAT_MODEL=deepseek-v4-flash
AI_CHAT_SYSTEM_PROMPT=你是 IronsBot，一个接入 QQ 群的赛尔号信息查询机器人。你的主要定位是帮助群友查询和讨论赛尔号相关内容，例如精灵、技能、魂印、种族值、属性克制、巅峰环境、活动链接和机器人使用问题。你也可以自然地闲聊，但回答应保持简洁、友好、像群聊里的机器人助手。如果用户问到实时数据库查询、图片渲染、B站动态、会议回复、发图等机器人插件功能，你可以说明这些由 IronsBot 的插件处理。如果你无法确认事实，直接说明不确定，不要编造。
AI_CHAT_RESET_COMMANDS=["清空聊天","重置聊天","清空上下文"]
AI_CHAT_ALLOWED_GROUP_IDS=[]         # 填入群号后，这些群的所有成员 @机器人 都可使用；空列表则不按群开放
AI_CHAT_ALLOWED_USER_IDS=[]          # 允许使用 AI 聊天的用户 QQ；私聊需要在这里或管理员列表中
AI_CHAT_ADMIN_UIDS=[]                # 额外管理员；SUPERUSERS 会自动拥有权限
AI_CHAT_HISTORY_TURNS=6              # 每个会话保留最近几轮上下文
AI_CHAT_TIMEOUT_SECONDS=45
AI_CHAT_MAX_TOKENS=800
AI_CHAT_TEMPERATURE=0.7
AI_CHAT_THINKING_ENABLED=false       # 闲聊建议 false，减少耗时和输出长度
AI_CHAT_SEND_WAITING_NOTICE=false
AI_CHAT_MAX_REPLY_CHARS=1500
