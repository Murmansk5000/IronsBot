# 复制此文件为 .env.dev、.env.prod 或 ironsbot.env.prod 并填写。
# 真实 env 文件包含密钥，不会由程序自动创建。
# 首次自动创建 ironsbot.toml 时，会在同目录额外生成 ironsbot.env.example 供参考。
#
# 行为配置不再写成大型 JSON 环境变量。
# Docker / Unraid 建议保持 APP_CONFIG_PATH=/config/ironsbot.toml。
# 本地开发可改成 config.dev.toml 或 config/ironsbot.toml。
# 可从 config.example.toml 或 config.prod.toml 复制后修改。

# === 部署运行配置 ===
ENVIRONMENT=prod
DRIVER=~fastapi+~httpx
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
COMMAND_START=["/", ""]
APP_CONFIG_PATH=/config/ironsbot.toml

# === OneBot / NoneBot ===
ONEBOT_ACCESS_TOKEN= # 必填，OneBot 连接令牌，需要和 NapCat 等客户端一致
SUPERUSERS=[] # 必填，NoneBot 超级用户 QQ 列表；[123456789] 或 ["123456789"] 都可以

# === 无头赛尔号客户端凭据 ===
# 行为配置见 APP_CONFIG 的 [runtime.headless] 和 [runtime.headless_notice]。
HEADLESS_SEER_USER_ID=
HEADLESS_SEER_PASSWORD= # 密码（明文密码的 MD5 值）

# === AI / 图床密钥 ===
# 行为配置见 APP_CONFIG 的 [ai] 和 [message.sendpic]。
AI_KEY=
SENDPIC_CNB_TOKEN=

# === GitHub Actions 远程构建密钥 ===
# 当 APP_CONFIG 中启用 runtime.data_sync.sources.*.remote_build 时必填，
# 用于 /更新数据 触发 seer-unity-config-parser / seer-data / seerapi 等流水线。
# 建议 fine-grained token 对相关仓库授予：Actions read/write、Metadata read。
GITHUB_WORKFLOW_TOKEN=

# === 行为配置文件 ===
# 群号、用户别名、功能策略、B站订阅、会议号、消息动作、活动提醒、
# 战队快捷、渲染缓存、数据同步、定时重启等配置全部写在 APP_CONFIG TOML 中。
# 示例字段、默认值、中英文说明见 config.example.toml。
