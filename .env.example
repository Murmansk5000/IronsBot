# 复制此文件为 .env.dev 或 .env.prod 并填写。
# .env 文件无需手动创建，项目已内置。

# === 环境配置 ===
ENVIRONMENT=prod
DRIVER=~fastapi+~httpx
HOST=127.0.0.1
PORT=8080
ONEBOT_ACCESS_TOKEN= # 必填，OneBot 连接令牌，需要和 NapCat 等客户端一致
SUPERUSERS=[] # 必填，NoneBot 超级用户 QQ 列表；[123456789] 或 ["123456789"] 都可以
# === Unified feature policy ===
GROUP_ALIASES={"admin":123456789,"main":987654321}
USER_ALIASES={"owner":123456789}
FEATURE_GROUP_POLICY={"admin":["admin_notice"],"main":["seer","image","rank","meeting","activity_link","activity_link_push","seerinfo","bili_query","bili_push","activity_query","activity_push","server_status_query","server_status_push","team","ai","ai_intent"]}
FEATURE_USER_POLICY={"owner":["all"]}
FEATURE_SUPERUSER_BYPASS=false
SUPERUSER_PRIORITY=true # true 时超级管理员消息优先处理，普通用户事件会在超级管理员活跃时等待
SUPERUSER_PRIORITY_WAIT_TIMEOUT_SECONDS=300 # 普通用户等待超级管理员任务的最长秒数；0 表示一直等
BOT_RESTART_ENABLED=false # true 时按 BOT_RESTART_TIMES 定时重启机器人容器
BOT_RESTART_TIMES=04:30 # 每日重启时间，按 Asia/Shanghai；多个时间用逗号，例如 04:30,16:10
BOT_RESTART_GRACE_SECONDS=10 # 触发后等待多少秒再退出
BOT_RESTART_SIGNAL_PARENT=true # Docker/Gunicorn 内建议 true，用于退出主进程并让容器重启
LOG_LEVEL=INFO          # TRACE / DEBUG / INFO / WARNING / ERROR
COMMAND_START=["/", ""]
HELP_IGNORED_PLUGINS=["发图"] # 帮助列表中隐藏的插件名称；这里隐藏原作者 sendpic 示例插件

# === db_sync 插件（数据库同步控制） ===
# 默认关闭开机同步，保留定时同步。超级管理员可发送“/更新数据”或“/数据更新”手动同步。
DB_SYNC_ON_STARTUP=false
DB_SYNC_INTERVAL_ENABLED=true

# === seer_data 插件（数据库同步与游戏资源图片获取） ===
# 设置 SYNC_URL 后从远程自动拉取并定时更新；留空则从本地文件加载，不自动更新。
SEERAPI_SYNC_URL=https://github.com/Murmansk5000/seerapi/releases/download/ironsbot-data-latest/ironsbot-data.sqlite
# （可选）用于校验远程同步文件是否需要更新的指纹，留空则跳过验证
SEERAPI_FINGERPRINT_URL=https://github.com/Murmansk5000/seerapi/releases/download/ironsbot-data-latest/ironsbot-data.sqlite.sha256
SEERAPI_SYNC_INTERVAL_MINUTES=60       # 可选，默认 60，同步间隔（分钟）
SEERAPI_LOCAL_PATH=data/ironsbot-data.sqlite  # 可选，本地缓存/回退路径；Docker 建议放在 /app/data
ALIAS_SYNC_URL=https://github.com/Murmansk5000/seerapi/releases/download/alias-db-latest/aliases-data.sqlite
ALIAS_FINGERPRINT_URL=https://github.com/Murmansk5000/seerapi/releases/download/alias-db-latest/aliases-data.sqlite.sha256
ALIAS_SYNC_INTERVAL_MINUTES=60         # 可选，默认 60，同步间隔（分钟）
ALIAS_LOCAL_PATH=data/aliases-data.sqlite    # 可选，本地缓存/回退路径；Docker 建议放在 /app/data

# === get_seer_info 插件 ===
RENDER_CACHE_DIR=render_cache          # 可选，图片渲染缓存目录，默认为 nonebot-plugin-localstore 插件中的缓存目录
RENDER_CACHE_MAX_SIZE_MB=200           # 可选，图片渲染缓存最大大小（MB），默认 200
RENDER_CACHE_CLEAR_ON_STARTUP=true     # 可选，启动时是否清理渲染缓存


# === 无头赛尔号客户端配置，部分功能需要登录无头客户端获取数据 ===
HEADLESS_SEER_LOGIN_SERVER_ADDR=https://seer-login-ip.61.com/unity-ip.txt # 登录服务器地址来源，通常不用改
HEADLESS_SEER_USER_ID=12345678   # 米米号
HEADLESS_SEER_PASSWORD=...  # 密码（明文密码的MD5值）
HEADLESS_SEER_HEARTBEAT_INTERVAL=300  # 心跳间隔（秒）
HEADLESS_SEER_RECONNECT_RETRIES=-1  # 重连尝试次数，-1 表示无限重连
HEADLESS_SEER_RECONNECT_DELAY=5.0  # 重连延迟（秒）
HEADLESS_SEER_RECONNECT_DELAY_MAX=120.0  # 最大重连延迟（秒）
SEER_LOGIN_NOTICE=true  # 米米号无头客户端登录失败时私聊通知 SUPERUSERS
SEER_LOGIN_NOTICE_MESSAGE="无头米米号登录未成功。\n米米号：{user_id}\n状态：{reason}\n依赖米米号登录的功能可能不可用；请检查账号、MD5密码、网络或赛尔号服务器状态。"
HEADLESS_STATE_NOTICE=true # 无头登录状态从在线/离线发生变化时私聊通知 SUPERUSERS；正常维护窗口内不播报
HEADLESS_STATE_OFFLINE_MESSAGE="无头米米号已掉线。\n米米号：{user_id}\n状态：{reason}\n来源：{source}"
HEADLESS_STATE_ONLINE_MESSAGE="无头米米号已恢复登录。\n米米号：{user_id}\n来源：{source}"
HEADLESS_RECONNECT_CHECK_TIMES=00:01,00:02 # 每天这些时间点检查无头状态，掉线则尝试重连；支持 00:01,00:02 或 JSON 数组

# === 自定义米米号/战队查询插件 ===
SEER_QUERY_PLAYER_RATE_LIMIT_SECONDS=60 # 普通 QQ 每多少秒最多查询 1 个米米号；SUPERUSERS 不受限制，0 表示关闭
SEER_QUERY_PLAYER_FAILURE_RATE_LIMIT_SECONDS=10 # 米米号查询失败后普通 QQ 的冷却秒数；SUPERUSERS 不受限制，0 表示关闭
SEER_QUERY_PLAYER_SECTIONS=["basic","appearance","social","collection","rank","local_rank","achievement","peak","titles","pets","stages","battle","raw"]
SEER_QUERY_TEAM_SECTIONS=["basic","resource","facilities","status","logo","text"]
SEER_QUERY_RANK_LIMIT=10000  # 米米号查询时扫描前多少名图鉴/成就排行；0 表示不查
SEER_QUERY_RANK_PAGE_SIZE=100       # 每次拉取的排行榜条数；4481 排行榜接口建议不超过 100
SEER_QUERY_RANK_PAGE_CACHE=true     # 缓存全服榜单页，减少重复联网
SEER_QUERY_RANK_PAGE_CACHE_TTL_SECONDS=3600
SEER_QUERY_RANK_PAGE_CACHE_PATH=data/custom_get_seer_info/rank_page_cache.sqlite
SEER_QUERY_PEAK_SUBKEY=     # 巅峰赛季榜 subkey，留空时读取 SeerAPI 当前赛季；可手动填赛季开始日期如 20260530
SEER_QUERY_LOCAL_RANK=true  # 启用“机器人查询过的米米号之间”的本地排名
SEER_QUERY_LOCAL_RANK_MAX_PLAYERS=5000 # 本地样本缓存最多保存多少个玩家
SEER_QUERY_CACHE_BATCH_LIMIT=100       # 超级管理员批量缓存榜单时每次最多处理多少个账号
SEER_QUERY_CACHE_AUTO_REFRESH=true     # 启动定时样本缓存刷新
SEER_QUERY_CACHE_REFRESH_HOUR=3        # 每天几点刷新样本缓存
SEER_QUERY_CACHE_REFRESH_MINUTE=30     # 每天几分刷新样本缓存
SEER_QUERY_CACHE_REFRESH_LIMIT=1000    # 每轮最多刷新多少个玩家
SEER_QUERY_CACHE_REFRESH_MAX_AGE_HOURS=24 # 只刷新超过这个小时数未更新的玩家
SEER_QUERY_CACHE_REFRESH_INTERVAL_SECONDS=0.5 # 每个玩家刷新之间的间隔，避免请求过密
SEER_QUERY_LOCAL_RANK_PATH=data/custom_get_seer_info/player_query_cache.sqlite
SEER_QUERY_SKIN_PRICE=true

# === 自定义会议回复插件 ===
# 只填会议号即可自动生成链接；可用 1234567890 或 123-456-7890。
MEETING_NUMBER=
MEETING_TEMPLATE="腾讯会议\n腾讯会议号：{meeting_number}\n点击链接直接加入：{meeting_url}"

# === 自定义 B 站动态监控插件 ===
BILI_UIDS=[1310714247]
BILI_DATA_DIR=data/bilibili_monitor # 保存 B 站 Cookie 与动态时间缓存；Docker 建议挂载 /app/data
BILI_HISTORY_MAX_ITEMS=500 # B站历史动态最多保留条数
BILI_CHECK_MINUTES=5
BILI_SLEEP_START=23
BILI_SLEEP_END=7
BILI_SLEEP_MINUTES=30

# === 自定义启动通知插件 ===
# 默认发送给 SUPERUSERS。
STARTUP_NOTICE=true
STARTUP_MESSAGE=机器人已开启。
STARTUP_DELAY=0

# === 文本发送插件 ===
# 适合简单的“指令发固定文本 / 定时发固定文本”场景。
# 复杂业务仍建议写业务插件，只复用 message_actions 的发送接口。
MSG_AT_TRIGGER=false  # 群聊中由用户触发的文本回复是否在开头 @ 触发者
MSG_REPLY_DEFAULT_LINES=0  # 默认回复消息行数；0 表示不限制
MSG_REPLY_MIN_LINES=5      # 群内 /回复行数 可设置的最小值
MSG_REPLY_MAX_LINES=80     # 群内 /回复行数 可设置的最大值
MSG_REPLY_LIMIT_PATH=data/message_actions/reply_limits.sqlite  # 群回复行数设置的 SQLite 文件
# Message action targets are selected by each action feature and FEATURE_*_POLICY.
MSG_PRIVATE_COMMANDS=[{"id":"activity_link","feature":"activity_link","commands":["checkin","activity","link"],"message":"activity link"}]
MSG_PRIVATE_SCHEDULES=[{"id":"morning","feature":"activity_link_push","hour":8,"minute":30,"message":"good morning"}]
MSG_GROUP_COMMANDS=[{"id":"activity_link","feature":"activity_link","commands":["checkin","activity","link"],"message":"activity link"},{"id":"seerinfo_page","feature":"seerinfo","commands":["xm","xrym","seerinfo"],"message":"https://seerinfo.yuyuqaq.cn/"}]
MSG_GROUP_SCHEDULES=[{"id":"night","feature":"activity_link_push","hour":23,"minute":0,"message":"good night"}]

# === 活动结束提醒插件 ===
# 启动时扫描一次活动结束时间，每天 0 点再扫描一次，并注册到点发送的一次性提醒。
ACTIVITY_REMINDER=true
ACTIVITY_REMINDER_LEAD_HOURS=[11,1] # 提前多少小时提醒，例如 11 小时和 1 小时
ACTIVITY_REMINDER_GRACE_MINUTES=15  # 启动/零点扫描时错过提醒点多少分钟内仍补发
ACTIVITY_REMINDER_ONLY_SHOWN=true   # 只提醒活动中心可见活动
ACTIVITY_REMINDER_CACHE_PATH=data/activity_reminder/sent.sqlite
ACTIVITY_REMINDER_MESSAGE="⏰ 活动将在约 {lead_hours} 小时后结束\n{activity_list}"
# 超级管理员可发送 /当前活动、/活动列表、/活动时间 查看当前活动和剩余时间。

# === 开服了吗 / 管理员开服查询 / 开服广播 ===
# 普通用户发送“开服了吗”；超级管理员使用 /开服查询，会在无头未登录时尝试重连。
SERVER_STATUS_BROADCAST=false # true 时查询判断为已开服后广播；默认关闭
SERVER_STATUS_BROADCAST_MESSAGE=赛尔号已经开服了。
SERVER_STATUS_BROADCAST_COOLDOWN_MINUTES=1440 # 0 表示不限制；默认每 24 小时最多广播一次

# === 自定义战队群快捷查询插件 ===
# 给战队群使用：群友发送“战队”时，自动查询下方配置的多个战队 ID。
# 只填示例，不要把真实群号、战队号提交到 Git；生产环境请在 .env.prod 或 Unraid 变量里填写。
TEAM_IDS=[]        # 收到快捷指令后依次查询的战队 ID
TEAM_COMMANDS=["战队"]  # 精确匹配的战队群快捷指令
TEAM_RESOURCE_USERS=[]  # 任一战队资源低于 1000 时要 @ 的 QQ 用户；可填 [123456789] 或 123456789
TEAM_RESOURCE_MESSAGE=出来买资源，别逼我求你😡

# === AI 意图动作插件 ===
# 用关键词粗筛消息，再让 AI 判断意图；命中后触发固定文本或战队快捷查询。
# 默认规则：消息包含“战队”时，AI 判断用户是否想加入战队；如果是，则发送 TEAM_IDS 配置的战队信息。
AI_INTENT_ACTIONS_ENABLED=true
AI_ACTION_TEMPLATES={"keyword_info":{"action":"ai_reply","intent":"The message asks for information about the configured keywords.","reply_prompt":"You are IronsBot. Keywords: {keywords}\nUser message: {message}\nReply briefly and directly."}}
AI_INTENT_ACTIONS=[{"template":"join_team"},{"id":"event_help","template":"keyword_info","keywords":["event","activity"],"intent":"The user is asking about Seer events or activity links."}]

# === AI 聊天插件（DeepSeek / OpenAI 兼容接口） ===
AI_KEY=                     # DeepSeek API Key，不要提交真实密钥
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_PROMPT=你是 IronsBot，一个接入 QQ 群的赛尔号信息查询机器人。你的主要定位是帮助群友查询和讨论赛尔号相关内容，例如精灵、技能、魂印、种族值、属性克制、巅峰环境、活动链接和机器人使用问题。你也可以自然地闲聊，但回答应保持简洁、友好、像群聊里的机器人助手。如果用户问到实时数据库查询、图片渲染、B站动态、会议回复、发图等机器人插件功能，你可以说明这些由 IronsBot 的插件处理。如果你无法确认事实，直接说明不确定，不要编造。
AI_RESET_COMMANDS=["清空聊天","重置聊天","清空上下文"]
AI_HISTORY_TURNS=6              # 每个会话保留最近几轮上下文
AI_MEMORY=true                  # 启用同一 QQ 用户跨私聊/群聊共享的长期记忆
AI_MEMORY_PATH=data/ai_chat/memory.sqlite
AI_MEMORY_TURNS=8
AI_MEMORY_MAX_CHARS=1200
AI_TIMEOUT=45
AI_MAX_TOKENS=800
AI_TEMPERATURE=0.7
AI_THINKING=false       # 闲聊建议 false，减少耗时和输出长度
AI_WAITING_NOTICE=false
AI_MAX_REPLY_CHARS=1500
