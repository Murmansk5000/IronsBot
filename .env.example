# SPDX-License-Identifier: MIT
# IronsBot only reads this configuration path and secrets from the environment.
# IronsBot 只从环境变量读取配置路径和以下密钥；其余设置均写入 TOML。

# EN: Behavior TOML path. Docker / Unraid normally uses /config/ironsbot.toml.
# ZH: 行为配置 TOML 路径；Docker / Unraid 通常保持 /config/ironsbot.toml。
APP_CONFIG_PATH=/config/ironsbot.toml

# EN: OneBot reverse WebSocket token. Must match NapCat.
# ZH: OneBot 反向 WebSocket 令牌，必须与 NapCat 一致。
ONEBOT_ACCESS_TOKEN=

# EN: OpenAI-compatible API key.
# ZH: OpenAI 兼容 AI 接口密钥。
AI_KEY=

# EN: Optional primary Seer account ID and password MD5 for headless login.
# ZH: 可选，第 1 个无头账号使用的米米号和密码 MD5。
HEADLESS_SEER_USER_ID=
HEADLESS_SEER_PASSWORD=

# EN: Three workers are listed by default: the unsuffixed primary plus RANK_A
# and RANK_B. Add more matching named pairs as needed.
# ZH: 模板默认列出 3 个 worker：无后缀主账号，以及 RANK_A、RANK_B；
# 后续可按相同格式自行增加更多同名后缀账号对。
HEADLESS_SEER_USER_ID_RANK_A=
HEADLESS_SEER_PASSWORD_RANK_A=
HEADLESS_SEER_USER_ID_RANK_B=
HEADLESS_SEER_PASSWORD_RANK_B=

# EN: Optional CNB token for configured sendpic repositories.
# ZH: 可选，SendPic 使用 CNB 仓库时的访问令牌。
SENDPIC_CNB_TOKEN=

# EN: Optional GitHub token used by operations.data_sync remote builds.
# ZH: 可选，operations.data_sync 远程构建使用的 GitHub Token。
GITHUB_WORKFLOW_TOKEN=

# EN: Optional Docker Hub credentials for private extension package pulls.
# ZH: 可选，私有扩展包的 Docker Hub 凭据。不要写进 TOML。
# These credentials are used by a running bot for Docker API/Watchtower updates.
# The package reuses the primary HEADLESS_SEER_USER_ID/PASSWORD account.
# 扩展包复用上方第 1 个无头账号。
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_TOKEN=
