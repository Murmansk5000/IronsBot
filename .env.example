# 复制此文件为 .env.dev 或 .env.prod 并填写。
# .env 文件无需手动创建，项目已内置。

# === 环境配置 ===
ENVIRONMENT=prod
DRIVER=~fastapi+~httpx
HOST=127.0.0.1
PORT=8080
ONEBOT_ACCESS_TOKEN= # 必填，OneBot 连接令牌，需要和 NapCat 等客户端一致
SUPERUSERS=[] # 必填，NoneBot 超级用户 QQ 列表；[123456789] 或 ["123456789"] 都可以
# === Unified feature policy ===
GROUP_ALIASES={"admin":123456789,"main":987654321}
USER_ALIASES={"owner":123456789}
FEATURE_GROUP_POLICY={"admin":["admin_notice"],"main":["seer","image","rank","meeting","activity_link","activity_link_push","seerinfo","bili_query","bili_push","activity_query","activity_push","server_status_query","server_status_push","team","ai_chat","ai_intent"]}
FEATURE_USER_POLICY={"owner":["all"]}
FEATURE_SUPERUSER_BYPASS=true
SUPERUSER_PRIORITY=true # true 时超级管理员消息优先处理，普通用户事件会在超级管理员活跃时等待
SUPERUSER_PRIORITY_WAIT_TIMEOUT_SECONDS=300 # 普通用户等待超级管理员任务的最长秒数；0 表示一直等
BOT_RESTART_CONFIG={"enabled":false,"times":"04:30","grace_seconds":10,"signal_parent":true} # 每日定时重启配置；times 可填 04:30,16:10
LOG_LEVEL=INFO          # TRACE / DEBUG / INFO / WARNING / ERROR
COMMAND_START=["/", ""]
HELP_IGNORED_PLUGINS=["发图"] # 帮助列表中隐藏的插件名称；这里隐藏原作者 sendpic 示例插件

# === db_sync 插件（数据库同步控制） ===
# 默认关闭开机同步，保留定时同步。超级管理员可发送“/更新数据”或“/数据更新”手动同步。
DATA_SYNC_CONFIG={"on_startup":false,"interval_enabled":true,"sources":{"seerapi":{"url":"https://github.com/Murmansk5000/seerapi/releases/download/ironsbot-data-latest/ironsbot-data.sqlite","fingerprint_url":"https://github.com/Murmansk5000/seerapi/releases/download/ironsbot-data-latest/ironsbot-data.sqlite.sha256","interval_minutes":60,"local_path":"data/ironsbot-data.sqlite"},"aliases":{"url":"https://github.com/Murmansk5000/seerapi/releases/download/alias-db-latest/aliases-data.sqlite","fingerprint_url":"https://github.com/Murmansk5000/seerapi/releases/download/alias-db-latest/aliases-data.sqlite.sha256","interval_minutes":60,"local_path":"data/aliases-data.sqlite"}}}

# DATA_SYNC_CONFIG.sources: url = SQLite 下载地址, fingerprint_url = SHA256 指纹地址, interval_minutes = 自动同步间隔, local_path = 本地缓存路径。

# === get_seer_info 插件 ===
RENDER_CONFIG={"cache_dir":"render_cache","cache_max_size_mb":200,"clear_on_startup":true}


# === 无头赛尔号客户端配置，部分功能需要登录无头客户端获取数据 ===
HEADLESS_SEER_LOGIN_SERVER_ADDR=https://seer-login-ip.61.com/unity-ip.txt # 登录服务器地址来源，通常不用改
HEADLESS_SEER_USER_ID=12345678   # 米米号
HEADLESS_SEER_PASSWORD=...  # 密码（明文密码的MD5值）
HEADLESS_SEER_HEARTBEAT_INTERVAL=300  # 心跳间隔（秒）
HEADLESS_SEER_RECONNECT_RETRIES=-1  # 重连尝试次数，-1 表示无限重连
HEADLESS_SEER_RECONNECT_DELAY=5.0  # 重连延迟（秒）
HEADLESS_SEER_RECONNECT_DELAY_MAX=120.0  # 最大重连延迟（秒）
HEADLESS_NOTICE_CONFIG={"login_notice":true,"login_notice_message":"无头米米号登录未成功。\n米米号：{user_id}\n状态：{reason}\n依赖米米号登录的功能可能不可用；请检查账号、MD5密码、网络或赛尔号服务器状态。","state_notice":true,"state_offline_message":"无头米米号已掉线。\n米米号：{user_id}\n状态：{reason}\n来源：{source}","state_online_message":"无头米米号已恢复登录。\n米米号：{user_id}\n来源：{source}","reconnect_check_times":"00:01,00:02"}

# === 自定义米米号/战队查询插件 ===
SEER_QUERY_CONFIG={"player":{"rate_limit_seconds":60,"failure_rate_limit_seconds":10,"timeout_seconds":30,"detail_timeout_seconds":90,"sections":["basic","appearance","social","collection","rank","local_rank","achievement","peak","titles","pets","stages","battle","raw"]},"team":{"rate_limit_seconds":60,"failure_rate_limit_seconds":10,"timeout_seconds":20,"sections":["basic","resource","facilities","status","logo","text"]},"rank":{"limit":10000,"page_size":100,"page_cache":true,"page_cache_ttl_seconds":3600,"page_cache_path":"data/custom_get_seer_info/rank_page_cache.sqlite","peak_subkey":null},"local_rank":{"enabled":true,"max_players":5000,"batch_limit":100,"auto_refresh":true,"refresh_hour":3,"refresh_minute":30,"refresh_limit":1000,"refresh_max_age_hours":24,"refresh_interval_seconds":0.5,"path":"data/custom_get_seer_info/player_query_cache.sqlite"}}

# === 自定义会议回复插件 ===
# 只填会议号即可自动生成链接；可用 1234567890 或 123-456-7890。
MEETING_CONFIG={"number":"","template":"腾讯会议\n腾讯会议号：{meeting_number}\n点击链接直接加入：{meeting_url}","commands":["开播","会议"]}

# === 自定义 B 站动态监控插件 ===
BILI_CONFIG={"uids":[1310714247],"storage":{"data_dir":"data/bilibili_monitor","history_max_items":1000},"polling":{"default_minutes":30,"windows":[{"start":"07:00","end":"23:00","minutes":5}]},"push":{"default_mode":"full","link_only_groups":[],"link_only_users":[]},"filters":{"suppress_push_patterns":["恭喜.*获得","记得及时查看私信通知","中奖","抽奖结果"]}} # 默认 30 分钟拉取一次；07:00-23:00 每 5 分钟拉取一次；可给部分群/用户只推链接；抽奖中奖结果只入库不推送

# === 自定义启动通知插件 ===
# 默认发送给 SUPERUSERS。
STARTUP_CONFIG={"enabled":true,"message":"机器人已开启。","delay":0}

# === 文本发送插件 ===
# 适合简单的“指令发固定文本 / 定时发固定文本”场景。
# 复杂业务仍建议写业务插件，只复用 message_actions 的发送接口。
MSG_CONFIG={"reply":{"default_lines":-1,"min_lines":5,"max_lines":80,"limit_path":"data/message_actions/reply_limits.sqlite"},"private_commands":[{"id":"activity_link","feature":"activity_link","commands":["checkin","activity","link"],"message":"activity link"}],"private_schedules":[],"group_commands":[{"id":"activity_link","feature":"activity_link","commands":["checkin","activity","link"],"message":"activity link"},{"id":"seerinfo_page","feature":"seerinfo","commands":["xm","xrym","seerinfo"],"message":"https://seerinfo.yuyuqaq.cn/"}],"group_schedules":[{"id":"night","feature":"activity_link_push","hour":23,"minute":0,"message":"good night"}]}

# === 活动结束提醒插件 ===
# 启动时扫描一次活动结束时间，每天 0 点再扫描一次，并注册到点发送的一次性提醒。
ACTIVITY_CONFIG={"enabled":true,"lead_hours":[11,1],"grace_minutes":15,"only_shown":true,"cache_path":"data/activity_reminder/sent.sqlite","message":"⏰ 本周活动将在约 {lead_hours} 小时后结束\n{activity_list}"}
# 超级管理员可发送 /当前活动、/活动列表、/活动时间 查看当前活动和剩余时间。

# === 开服了吗 / 管理员开服查询 / 开服广播 ===
# 普通用户发送“开服了吗”；超级管理员使用 /开服查询，会在无头未登录时尝试重连。
SERVER_STATUS_CONFIG={"broadcast":false,"broadcast_message":"赛尔号已经开服了。","broadcast_cooldown_minutes":1440}

# === 自定义战队群快捷查询插件 ===
# 给战队群使用：群友发送“战队”时，自动查询下方配置的多个战队 ID。
# 只填示例，不要把真实群号、战队号提交到 Git；生产环境请在 .env.prod 或 Unraid 变量里填写。
TEAM_IDS=[]        # 收到快捷指令后依次查询的战队 ID
TEAM_RESOURCE_USERS=[]  # 任一战队资源低于 1000 时要 @ 的 QQ 用户；可填 [123456789] 或 123456789
TEAM_CONFIG={"commands":["战队"],"resource_threshold":1000,"query_timeout_seconds":20,"resource_message":"出来买资源，别逼我求你😡"} # commands 是触发口令；resource_threshold 是资源提醒阈值；query_timeout_seconds 是战队快捷查询超时；resource_message 是提醒文本

# === AI 聊天与 AI 意图动作插件（DeepSeek / OpenAI 兼容接口） ===
AI_KEY=                     # DeepSeek API Key，不要提交真实密钥
AI_CONFIG={"base_url":"https://api.deepseek.com","model":"deepseek-v4-pro","prompt":"你是 IronsBot，一个接入 QQ 群的赛尔号信息查询机器人。回答应简洁、友好、诚实；无法确认时直接说明不确定，不要编造。","reset_commands":["清空聊天","重置聊天","清空上下文"],"history_turns":6,"memory":true,"memory_path":"data/ai_chat/memory.sqlite","memory_turns":8,"memory_max_chars":1200,"timeout":45,"max_tokens":800,"temperature":0.7,"thinking":false,"waiting_notice":false,"max_reply_chars":1500,"intent_actions_enabled":true,"action_templates":{},"intent_actions":[{"template":"join_team"}]}
