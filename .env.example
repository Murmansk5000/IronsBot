# SPDX-License-Identifier: MIT
# IronsBot reads the config path, deployment credentials, and optional OneBot
# deployment overrides from the environment.
# IronsBot 从环境变量读取配置路径、部署凭据和可选的 OneBot 部署覆盖项。
# Local startup reads .env first and then .env.<ENVIRONMENT>. Existing process
# or container variables always win over both files.
# 本机启动先读取 .env，再读取 .env.<ENVIRONMENT>；系统或容器变量优先级最高。

# EN: Select the scoped local env file. Defaults to prod when omitted.
# ZH: 选择本机环境文件；省略时默认读取 .env.prod。
ENVIRONMENT=prod

# EN: Behavior TOML path. Docker / Unraid normally uses /config/ironsbot.toml.
# ZH: 行为配置 TOML 路径；Docker / Unraid 通常保持 /config/ironsbot.toml。
APP_CONFIG_PATH=/config/ironsbot.toml

# EN: OneBot reverse WebSocket token. Must match NapCat.
# ZH: OneBot 反向 WebSocket 令牌，必须与 NapCat 一致。
ONEBOT_ACCESS_TOKEN=
# Optional deployment overrides for [bot.onebot]. TOML values are used when
# these variables are absent.
# 可选的 [bot.onebot] 部署覆盖项；未设置时使用 TOML 值。
ONEBOT_ENABLED=true
ONEBOT_SEND_MESSAGES=true
ONEBOT_IDENTITY_VERIFICATION=false
# Trusted official bot QQ seen by NapCat. The suffix must match a declared
# official account alias.
# NapCat 中看到的可信官方机器人 QQ；后缀必须匹配已声明账号别名。
ONEBOT_TRUSTED_OFFICIAL_BOT_EXAMPLE_BOT=
# QQ Official credentials. The suffix matches an uppercase account alias.
QQ_OFFICIAL_APP_ID_EXAMPLE_BOT=
QQ_OFFICIAL_SECRET_EXAMPLE_BOT=

# EN: OpenAI-compatible API key.
# ZH: OpenAI 兼容 AI 接口密钥。
AI_KEY=

# EN: One plain-text password per player ID declared in [[seer.player_accounts]].
#     IronsBot derives the login MD5 in memory.
# ZH: 为 [[seer.player_accounts]] 中需要登录的每个米米号设置明文密码；
#     IronsBot 只在内存中转换为登录 MD5。
SEER_PASSWORD_123456789=
SEER_PASSWORD_987654321=

# EN: Optional CNB token for configured sendpic repositories.
# ZH: 可选，SendPic 使用 CNB 仓库时的访问令牌。
SENDPIC_CNB_TOKEN=

# EN: Optional GitHub token used by operations.data_sync remote builds.
# ZH: 可选，operations.data_sync 远程构建使用的 GitHub Token。
GITHUB_WORKFLOW_TOKEN=

# EN: Optional Docker Hub credentials for private extension package pulls.
# ZH: 可选，私有扩展包的 Docker Hub 凭据。不要写进 TOML。
# These credentials are used by a running bot for Docker API/Watchtower updates.
# The package uses the public account library and does not define credentials.
# 扩展包复用公共账号库，不单独定义凭据。
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_TOKEN=
