# 复制此文件为 .env.dev 或 .env.prod 并填写。
# .env 文件无需手动创建，项目已内置。

# === 环境配置 ===
ENVIRONMENT=prod
DRIVER=~fastapi+~httpx
HOST=0.0.0.0
PORT=8080
ONEBOT_ACCESS_TOKEN= # 必填，OneBot 连接令牌，需要和 NapCat 等客户端一致
SUPERUSERS=[] # 必填，NoneBot 超级用户 QQ 列表；[123456789] 或 ["123456789"] 都可以
# === Unified feature policy ===
GROUP_ALIASES={"admin":123456789,"main":987654321}
USER_ALIASES={"owner":123456789}
FEATURE_GROUP_POLICY={"admin":["admin_notice"],"main":["seer","image","rank","meeting","activity_link","activity_link_push","seerinfo","bili_query","bili_push","activity_query","activity_push","server_status_query","server_status_push","team","ai_chat","ai_intent"]}
FEATURE_USER_POLICY={"owner":["all"]}
FEATURE_SUPERUSER_BYPASS=true
# 超级管理员优先级配置见 MODULES.priority；定时重启配置见 MODULES.restart。
LOG_LEVEL=INFO          # TRACE / DEBUG / INFO / WARNING / ERROR
COMMAND_START=["/", ""]
# 帮助隐藏插件配置见 MODULES.help。

# === db_sync 插件（数据库同步控制） ===
# 默认关闭开机同步，保留定时同步。超级管理员可发送“/更新数据”或“/数据更新”手动同步。
DATA_SYNC_CONFIG={"on_startup":false,"interval_enabled":true,"sources":{"seerapi":{"url":"https://github.com/Murmansk5000/seerapi/releases/download/ironsbot-data-latest/ironsbot-data.sqlite","fingerprint_url":"https://github.com/Murmansk5000/seerapi/releases/download/ironsbot-data-latest/ironsbot-data.sqlite.sha256","interval_minutes":60,"local_path":"data/ironsbot-data.sqlite"},"aliases":{"url":"https://github.com/Murmansk5000/seerapi/releases/download/alias-db-latest/aliases-data.sqlite","fingerprint_url":"https://github.com/Murmansk5000/seerapi/releases/download/alias-db-latest/aliases-data.sqlite.sha256","interval_minutes":60,"local_path":"data/aliases-data.sqlite"}}}

# DATA_SYNC_CONFIG.sources: url = SQLite 下载地址, fingerprint_url = SHA256 指纹地址, interval_minutes = 自动同步间隔, local_path = 本地缓存路径。

# === get_seer_info 插件 ===
# 渲染缓存配置见 MODULES.render。

# === 模块配置（统一入口，可选） ===
# 默认模块配置集中写在 ironsbot/shared/config/config.py。
# 生产环境通常只需要填写密钥、米米号、战队 ID、会议号和功能策略。
# 如确实要覆盖模块默认值，可只写需要覆盖的部分：
# MODULES={"bilibili":{"push":{"groups":{"main":{"uids":[1310714247],"mode":"full"}}}}}


# === 无头赛尔号客户端配置，部分功能需要登录无头客户端获取数据 ===
HEADLESS_SEER_LOGIN_SERVER_ADDR=https://seer-login-ip.61.com/unity-ip.txt # 登录服务器地址来源，通常不用改
HEADLESS_SEER_USER_ID=12345678   # 米米号
HEADLESS_SEER_PASSWORD=...  # 密码（明文密码的MD5值）
HEADLESS_SEER_HEARTBEAT_INTERVAL=300  # 心跳间隔（秒）
HEADLESS_SEER_RECONNECT_RETRIES=-1  # 重连尝试次数，-1 表示无限重连
HEADLESS_SEER_RECONNECT_DELAY=5.0  # 重连延迟（秒）
HEADLESS_SEER_RECONNECT_DELAY_MAX=120.0  # 最大重连延迟（秒）
# 无头登录状态通知配置见 MODULES.headless_notice。

# === 自定义米米号/战队查询插件 ===
# 配置见 MODULES.seer。

# === 自定义会议回复插件 ===
# 只填会议号即可自动生成链接；可用 1234567890 或 123-456-7890。
# 会议回复配置见 MODULES.meeting；会议号属于私密运行配置，生产环境可通过 MODULES.meeting.number 填写。

# === 自定义 B 站动态监控插件 ===
# 配置见 MODULES.bilibili。默认 30 分钟拉取一次；07:00-23:00 每 5 分钟拉取一次。
# push.groups/users 必须显式配置接收目标；每个目标可按 UID 设置 full/link；抽奖中奖结果只入库不推送。
# 示例：{"push":{"groups":{"anjie":{"uids":[1310714247,375750254],"mode":"full","uid_modes":{"375750254":"link"}}}}}
# 上例表示 anjie 群订阅赛尔号官号和 UID 375750254，其中 375750254 只推送链接；其他群可单独写自己的订阅列表。

# === 自定义启动通知插件 ===
# 默认发送给 SUPERUSERS。
# 启动通知配置见 MODULES.startup。

# === 文本发送插件 ===
# 适合简单的“指令发固定文本 / 定时发固定文本”场景。
# 复杂业务仍建议写业务插件，只复用 message_actions 的发送接口。
# 配置见 MODULES.message。

# === 活动结束提醒插件 ===
# 启动时扫描一次活动结束时间，每天 0 点再扫描一次，并注册到点发送的一次性提醒。
# 配置见 MODULES.activity。
# 超级管理员可发送 /当前活动、/活动列表、/活动时间 查看当前活动和剩余时间。

# === 开服了吗 / 管理员开服查询 / 开服广播 ===
# 普通用户发送“开服了吗”；超级管理员使用 /开服查询，会在无头未登录时尝试重连。
# 开服查询和广播配置见 MODULES.server_status。

# === 自定义战队群快捷查询插件 ===
# 给战队群使用：群友发送“战队”时，自动查询下方配置的多个战队 ID。
# 只填示例，不要把真实群号、战队号提交到 Git；生产环境请在 .env.prod 或 Unraid 变量里填写。
TEAM_IDS=[]        # 收到快捷指令后依次查询的战队 ID
TEAM_RESOURCE_USERS=[]  # 任一战队资源低于 1000 时要 @ 的 QQ 用户；可填 [123456789] 或 123456789
# 行为配置见 MODULES.team。TEAM_IDS / TEAM_RESOURCE_USERS 因为含隐私 ID，仍保留单独变量。

# === AI 聊天与 AI 意图动作插件（DeepSeek / OpenAI 兼容接口） ===
AI_KEY=                     # DeepSeek API Key，不要提交真实密钥
# 行为配置见 MODULES.ai，包括聊天参数、意图动作、@ 拦截冷却和提示文案。
