<!doctype html>
{% from "skill_card_macro.html.j2" import skill_card %}
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <style>
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; background: #071426; }
    body {
      color: #eaf6ff;
      font-family: "Microsoft YaHei", "Source Han Sans SC", sans-serif;
    }
    .panel { width: 100%; padding: 24px; }
    .header {
      display: flex; align-items: end; justify-content: space-between;
      padding: 0 4px 16px; border-bottom: 2px solid #4796d8;
      margin-bottom: 14px;
    }
    .title { font-size: 29px; font-weight: 800; letter-spacing: 1px; }
    .cycle { color: #8bb9e4; font-size: 13px; }
    .list { display: flex; flex-direction: column; gap: 8px; }
    .category {
      display: flex; align-items: center; min-height: 54px; padding: 10px 14px;
      background: linear-gradient(90deg, #184d82, #10345b);
      border: 1px solid #4995d4; border-radius: 4px;
    }
    .key {
      flex: 0 0 42px; color: #91e7ff; font-weight: 800; font-size: 21px;
      text-transform: lowercase;
    }
    .category-name { flex: 1; font-size: 20px; font-weight: 700; }
    .category-count { color: #a9cde8; font-size: 15px; }
    .arrow { margin-right: 8px; color: #86e6ff; }
    .pool-preview {
      margin-left: 16px; padding: 14px; background: #0b223c;
      border-left: 3px solid #3d88c8;
    }
    .pool-title {
      margin-bottom: 10px; color: #d9f4ff; font-size: 18px; font-weight: 800;
    }
    .pool-matrix {
      width: 100%; border-collapse: collapse; table-layout: fixed;
    }
    .pool-cell {
      min-width: 0; min-height: 52px; padding: 8px;
      border: 1px solid #315f8a;
      color: #d9ecf8; font-size: 13px; line-height: 1.45;
      overflow-wrap: anywhere;
    }
    .pool-corner, .pool-row-label { width: 142px; }
    .pool-corner, .pool-column, .pool-row-label {
      text-align: center; vertical-align: middle;
      background: #123b62; color: #9fe8ff; font-weight: 800;
    }
    .pool-corner { font-size: 12px; }
    .pool-corner span { display: block; }
    .pool-diagonal {
      text-align: center; vertical-align: middle; color: #688aa5; font-size: 18px;
    }
    .pool-pets { display: flex; flex-wrap: wrap; align-items: center; gap: 5px; }
    .pool-avatar {
      width: 48px; height: 48px; object-fit: contain; padding: 2px;
      background: #071426; border: 1px solid #315f8a; border-radius: 3px;
    }
    .pool-avatar-missing {
      width: 48px; height: 48px; background: #102f50;
      border: 1px dashed #426d91; border-radius: 3px;
    }
    .expert-transitions { width: 100%; border-collapse: collapse; table-layout: fixed; }
    .expert-direction, .expert-names {
      min-width: 0; min-height: 52px; padding: 10px 12px;
      border: 1px solid #315f8a;
    }
    .expert-direction {
      width: 150px; text-align: center; vertical-align: middle;
      background: #123b62; color: #91e7ff; font-size: 15px; font-weight: 800;
    }
    .expert-direction .transition-arrow { color: #f4dc8f; }
    .expert-names { background: #0e2d4d; }
    .pool-empty { color: #688aa5; }
    .pool-other { margin-top: 12px; }
    .pool-other-title { margin-bottom: 6px; color: #f4dc8f; font-weight: 800; }
    .pool-other-row { display: flex; gap: 12px; padding: 6px 0; }
    .pool-other-direction { flex: 0 0 180px; color: #91e7ff; font-weight: 700; }
    .item {
      display: flex; align-items: stretch; min-height: 100px; margin-left: 16px;
      padding: 10px 14px; background: #0c2744; border-left: 3px solid #3d88c8;
    }
    .item.no-image { min-height: 58px; }
    .item.skill-item { min-height: 0; }
    .skill-content { flex: 1; min-width: 0; }
    .skill-item .sk-card { margin: 0; }
    .skill-links { margin: 6px 0 0; color: #8dc9eb; font-size: 12px; }
    {% include "skill_card.css" %}
    .thumbnail-frame {
      display: flex; align-items: center;
      justify-content: center; margin-right: 13px; padding: 3px;
      background: #071426; border: 1px solid #315f8a; border-radius: 3px;
    }
    .thumbnail-frame.square { flex: 0 0 110px; height: 110px; }
    .thumbnail-frame.portrait { flex: 0 0 82px; height: 110px; }
    .thumbnail-frame.pending {
      padding: 12px; text-align: center; color: #a9cde8;
      background: linear-gradient(135deg, #102f50, #0b2038);
    }
    .thumbnail-notice { font-size: 13px; line-height: 1.45; }
    .thumbnail {
      display: block; max-width: 100%; max-height: 100%; width: auto; height: auto;
      object-fit: contain;
    }
    .content { display: flex; min-width: 0; flex: 1; gap: 16px; }
    .content-main { min-width: 0; flex: 1 1 auto; padding-top: 1px; }
    .content-side {
      flex: 0 0 330px; min-width: 0; padding-left: 14px;
      border-left: 1px solid #285878;
    }
    .item-name { font-size: 18px; font-weight: 700; overflow-wrap: anywhere; }
    .metadata {
      display: flex; align-items: center; gap: 4px; margin-top: 2px;
      color: #8dc9eb; font-size: 12px; overflow-wrap: anywhere;
    }
    .metadata-icon { width: 16px; height: 16px; object-fit: contain; }
    .item-description {
      margin-top: 4px; color: #b5d1e4; font-size: 13px; line-height: 1.35;
      overflow-wrap: anywhere;
    }
    .stat-grid {
      display: flex; flex-wrap: nowrap; gap: 3px;
      margin-top: 3px;
    }
    .stat-grid.skill { flex-wrap: wrap; margin-top: 0; }
    .stat-grid.skill .stat { flex: 0 0 auto; }
    .stat-grid.skill .stat span::after { content: "："; }
    .stat-grid.two-column { display: flex; flex-direction: column; gap: 3px; }
    .stat-row { display: flex; gap: 3px; }
    .stat-row .stat { flex: 1 1 0; }
    .stat {
      display: flex; justify-content: space-between;
      min-width: 0;
      gap: 2px; padding: 2px 3px;
      color: #9dc7df; background: #102f50; border: 1px solid #285878; font-size: 11px;
    }
    .stat span { white-space: nowrap; }
    .stat strong { color: #f4dc8f; font-weight: 700; }
    .stat-total {
      margin-top: 7px; color: #f4dc8f; font-size: 12px; font-weight: 700;
      text-align: right;
    }
    .side-title { color: #a5dcff; font-size: 13px; font-weight: 700; }
    .side-description {
      margin-top: 5px; color: #b5d1e4; font-size: 13px; line-height: 1.35;
      overflow-wrap: anywhere; white-space: pre-line;
    }
    .footer {
      margin-top: 16px; padding: 12px; text-align: center; color: #b7d3e8;
      border-top: 1px solid #285b87; font-size: 14px;
    }
    .footer kbd { padding: 1px 6px; color: #dff7ff; background: #1b5385; border-radius: 2px; }
  </style>
</head>
<body>
  <main class="panel">
    <header class="header">
      <div class="title">🆕 {{ menu_title }}</div>
      <div class="cycle">内容版本：{{ content_date }}</div>
    </header>
    <section class="list">
      {% for item in items %}
        {% if item.is_category %}
          <div class="category">
            <div class="key">{{ item.code }}</div>
            <div class="arrow">{{ '↗' if item.pool_preview else ('▼' if item.expanded else '▶') }}</div>
            <div class="category-name">{{ item.name }}</div>
            <div class="category-count">{{ item.description }}</div>
          </div>
          {% if item.pool_preview %}
            <div class="pool-preview">
              <div class="pool-title">{{ item.pool_preview.title }}</div>
              {% if item.pool_preview.kind == 'standard' %}
                <table class="pool-matrix">
                  <thead><tr>
                    <th class="pool-cell pool-corner">
                      <span>原限制 ↓</span><span>新限制 →</span>
                    </th>
                    {% for header in item.pool_preview.headers %}
                      <th class="pool-cell pool-column">{{ header }}</th>
                    {% endfor %}
                  </tr></thead>
                  <tbody>
                  {% for row in item.pool_preview.matrix_rows %}
                    {% set row_index = loop.index0 %}
                    <tr>
                      <th class="pool-cell pool-row-label">{{ row.label }}</th>
                      {% for pets in row.cells %}
                        <td class="pool-cell{% if loop.index0 == row_index %} pool-diagonal{% endif %}">
                          {% if loop.index0 == row_index %}
                            —
                          {% elif pets %}
                            <div class="pool-pets">
                              {% for pet in pets %}
                                {% if pet.image %}
                                  <img class="pool-avatar" src="{{ pet.image }}" alt="">
                                {% else %}
                                  <span class="pool-avatar-missing"></span>
                                {% endif %}
                              {% endfor %}
                            </div>
                          {% endif %}
                        </td>
                      {% endfor %}
                    </tr>
                  {% endfor %}
                  </tbody>
                </table>
              {% else %}
                <table class="expert-transitions"><tbody>
                  {% for row in item.pool_preview.direction_rows %}
                    {% set direction_parts = row.direction.split(' → ') %}
                    <tr>
                      <th class="expert-direction">
                        {{ direction_parts[0] }}&nbsp;<span class="transition-arrow">→</span>&nbsp;{{ direction_parts[1] }}
                      </th>
                      <td class="expert-names">
                        {% if row.pets %}
                          <div class="pool-pets">
                            {% for pet in row.pets %}
                              {% if pet.image %}
                                <img class="pool-avatar" src="{{ pet.image }}" alt="">
                              {% else %}
                                <span class="pool-avatar-missing"></span>
                              {% endif %}
                            {% endfor %}
                          </div>
                        {% else %}
                          <span class="pool-empty">—</span>
                        {% endif %}
                      </td>
                    </tr>
                  {% endfor %}
                </tbody></table>
              {% endif %}
              {% if item.pool_preview.other_rows %}
                <div class="pool-other">
                  <div class="pool-other-title">其他变化</div>
                  {% for row in item.pool_preview.other_rows %}
                    <div class="pool-other-row">
                      <div class="pool-other-direction">{{ row.direction }}</div>
                      <div class="pool-pets">
                        {% for pet in row.pets %}
                          {% if pet.image %}
                            <img class="pool-avatar" src="{{ pet.image }}" alt="">
                          {% else %}
                            <span class="pool-avatar-missing"></span>
                          {% endif %}
                        {% endfor %}
                      </div>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% else %}
          <div class="item{% if not item.image and not item.image_notice %} no-image{% endif %}{% if item.skill %} skill-item{% endif %}">
            <div class="key">{{ item.code }}</div>
            {% if item.skill %}
              <div class="skill-content">
                {{ skill_card(item.skill, skill_type_icons) }}
                {% if item.friend_skill %}{{ skill_card(item.friend_skill, skill_type_icons) }}{% endif %}
                {% if item.description %}<div class="skill-links">{{ item.description }}</div>{% endif %}
              </div>
            {% else %}
            {% if item.image or item.image_notice %}
              <div class="thumbnail-frame {{ item.image_layout }}{% if item.image_notice %} pending{% endif %}">
                {% if item.image %}
                  <img class="thumbnail" src="{{ item.image }}">
                {% else %}
                  <div class="thumbnail-notice">{{ item.image_notice }}</div>
                {% endif %}
              </div>
            {% endif %}
            <div class="content">
              <div class="content-main">
                <div class="item-name">{{ item.name }}</div>
                {% if item.metadata or item.type_icon or item.gender_icon %}
                  <div class="metadata">
                    {{ item.metadata }}
                    {% if item.type_icon %}
                      <span>|</span><img class="metadata-icon" src="{{ item.type_icon }}">{{ item.type_name }}
                    {% endif %}
                    {% if item.gender_icon %}
                      <span>|</span><img class="metadata-icon" src="{{ item.gender_icon }}">{{ item.gender_name }}
                    {% endif %}
                  </div>
                {% endif %}
                {% if item.description %}<div class="item-description">{{ item.description }}</div>{% endif %}
              </div>
              {% if item.side_title or item.side_description or item.stats_total or item.stats %}
                <aside class="content-side">
                {% if item.stats_layout == "skill" and item.stats %}
                  <div class="stat-grid skill">
                    {% for label, value in item.stats %}
                      <div class="stat"><span>{{ label }}</span><strong>{{ value }}</strong></div>
                    {% endfor %}
                  </div>
                {% endif %}
                {% if item.side_title %}<div class="side-title">{{ item.side_title }}</div>{% endif %}
                {% if item.side_description %}<div class="side-description">{{ item.side_description }}</div>{% endif %}
                {% if item.stats_total %}<div class="stat-total">总和：{{ item.stats_total }}</div>{% endif %}
                {% if item.stats_layout == "two_column" and item.stats %}
                  <div class="stat-grid two-column">
                    {% for row in item.stats|batch(2) %}
                      <div class="stat-row">
                        {% for label, value in row %}
                          <div class="stat"><span>{{ label }}</span><strong>{{ value }}</strong></div>
                        {% endfor %}
                      </div>
                    {% endfor %}
                  </div>
                {% elif item.stats and item.stats_layout != "skill" %}
                  <div class="stat-grid">
                    {% for label, value in item.stats %}
                      <div class="stat"><span>{{ label }}</span><strong>{{ value }}</strong></div>
                    {% endfor %}
                  </div>
                {% endif %}
                </aside>
              {% endif %}
            </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </section>
    <footer class="footer">
      {% if focused_category %}
        发送数字查看详情，发送 <kbd>0</kbd> 退出
      {% else %}
        发送字母查看分类或完整池图片，发送编号查看详情，发送 <kbd>0</kbd> 退出
      {% endif %}
    </footer>
  </main>
</body>
</html>
