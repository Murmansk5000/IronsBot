<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style type="text/css">
        html, body { margin: 0; padding: 0; overflow: hidden; }
        body {
            background: #07101f;
            color: #f5f8ff;
            font-family: "Microsoft YaHei", "Source Han Sans SC", sans-serif;
        }
        .container {
            width: 100%;
            padding: 20px;
            box-sizing: border-box;
            background:
                radial-gradient(circle at 18% 8%, rgba(49, 86, 180, .18), transparent 28%),
                linear-gradient(180deg, #10182c 0, #07101f 38%, #081426 100%);
        }
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 2px 14px;
            border-bottom: 1px solid #263653;
            margin-bottom: 16px;
        }
        .page-title { font-size: 28px; font-weight: 800; }
        .page-time { color: #8998b2; font-size: 13px; white-space: nowrap; }
        .pool-section { margin-bottom: 22px; }
        .pool-header {
            display: flex;
            align-items: baseline;
            gap: 10px;
            margin-bottom: 11px;
            border-left: 4px solid #3284ff;
            padding-left: 10px;
        }
        .pool-title { color: #ffb83d; font-size: 21px; font-weight: 800; }
        .pool-period { color: #9ba9be; font-size: 13px; }
        .pool-total { color: #667996; font-size: 12px; margin-left: auto; }
        .rank-grid {
            display: flex;
            flex-wrap: wrap;
            width: 900px;
            gap: 9px;
        }
        .rank-card {
            position: relative;
            flex: none;
            width: 142px;
            min-width: 0;
            padding: 4px;
            background: #111a2b;
            border: 1px solid #26344d;
            border-radius: 7px;
            box-sizing: border-box;
        }
        .rank-card.top-1 { border-color: #d6ac37; }
        .rank-card.top-2 { border-color: #aab6c8; }
        .rank-card.top-3 { border-color: #b5784d; }
        .portrait {
            position: relative;
            width: 100%;
            height: 132px;
            overflow: hidden;
            border-radius: 4px;
            background: #1c2940;
        }
        .portrait img.head { width: 100%; height: 100%; object-fit: cover; display: block; }
        .rank-badge {
            position: absolute;
            top: 5px;
            left: 5px;
            min-width: 23px;
            height: 23px;
            padding: 0 4px;
            border-radius: 12px;
            box-sizing: border-box;
            background: rgba(22, 28, 42, .84);
            border: 1px solid rgba(255,255,255,.25);
            font-size: 13px;
            font-weight: 800;
            line-height: 21px;
            text-align: center;
        }
        .top-1 .rank-badge { color: #ffe06b; border-color: #d6ac37; }
        .top-2 .rank-badge { color: #e5ecf5; border-color: #aab6c8; }
        .top-3 .rank-badge { color: #f1b48b; border-color: #b5784d; }
        .type-icon {
            position: absolute;
            top: 5px;
            right: 5px;
            width: 22px;
            height: 22px;
            object-fit: contain;
            filter: drop-shadow(0 1px 2px #000);
        }
        .pet-id {
            position: absolute;
            left: 5px;
            bottom: 4px;
            color: #d5deeb;
            font-size: 11px;
            font-weight: 700;
            text-shadow: 0 1px 3px #000, 0 0 2px #000;
        }
        .percentage {
            position: absolute;
            right: 0;
            bottom: 0;
            min-width: 34px;
            padding: 3px 5px;
            background: #d64b58;
            color: white;
            font-size: 12px;
            font-weight: 800;
            text-align: center;
        }
        .pet-name {
            height: 31px;
            padding: 6px 2px 1px;
            box-sizing: border-box;
            overflow: hidden;
            color: #f4f7fc;
            font-size: 13px;
            font-weight: 700;
            line-height: 18px;
            text-align: center;
            white-space: nowrap;
            text-overflow: ellipsis;
        }
        .vote-score {
            color: #55d9df;
            font-size: 12px;
            font-weight: 700;
            text-align: center;
            padding-bottom: 4px;
        }
        .footer {
            border-top: 1px solid #263653;
            padding-top: 12px;
            color: #72839e;
            font-size: 12px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="page-header">
            <div class="page-title">竞技池票选</div>
            <div class="page-time">生成于 {{ generated_at }}</div>
        </div>

        {% for pool in pools %}
        <section class="pool-section">
            <div class="pool-header">
                <span class="pool-title">{{ pool.title }}</span>
                <span class="pool-period">[{{ pool.period }}]</span>
                <span class="pool-total">共 {{ pool.ranks|length }} 只 · {{ pool.total_votes }} 票</span>
            </div>
            <div class="rank-grid">
                {% for rank in pool.ranks %}
                <div class="rank-card{% if rank.rank == 1 %} top-1{% elif rank.rank == 2 %} top-2{% elif rank.rank == 3 %} top-3{% endif %}">
                    <div class="portrait">
                        {% if rank.head_img %}<img class="head" src="{{ rank.head_img }}">{% endif %}
                        <span class="rank-badge">{{ rank.rank }}</span>
                        {% if rank.type_icon %}<img class="type-icon" src="{{ rank.type_icon }}">{% endif %}
                        <span class="pet-id">{{ rank.pet_id }}</span>
                        <span class="percentage">{{ rank.percentage }}%</span>
                    </div>
                    <div class="pet-name">{{ rank.name }}</div>
                    <div class="vote-score">得票数：{{ rank.score }}</div>
                </div>
                {% endfor %}
            </div>
        </section>
        {% endfor %}

        <div class="footer">IronsBot · 开源赛尔号信息查询机器人<br>项目链接：{{ project_url }}</div>
    </div>
</body>
</html>
