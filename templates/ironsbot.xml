<?xml version="1.0"?>
<Container version="2">
  <Name>ironsbot</Name>
  <Repository>murmansk5000/ironsbot:latest</Repository>
  <Registry>https://hub.docker.com/r/murmansk5000/ironsbot</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/Murmansk5000/IronsBot/issues</Support>
  <Project>https://github.com/Murmansk5000/IronsBot</Project>
  <Overview>IronsBot custom image for Seer information queries, NoneBot2/OneBot v11 messaging, and personal Unraid-friendly plugins.</Overview>
  <Description>IronsBot is a QQ bot based on NoneBot2 and OneBot v11. This custom image follows the upstream IronsBot project and adds local custom plugins for fixed image replies, Tencent Meeting replies, event links, Bilibili dynamic monitoring, and unsupported pet configuration query notices. Configure private values such as QQ IDs, group IDs, tokens, account credentials, and meeting numbers at runtime through this template.</Description>
  <Category>Tools:Utilities</Category>
  <WebUI/>
  <TemplateURL>https://raw.githubusercontent.com/Murmansk5000/IronsBot/main/templates/ironsbot.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/Murmansk5000/IronsBot/main/icon.svg</Icon>
  <ReadMe>https://github.com/Murmansk5000/IronsBot/blob/main/docker/README.md</ReadMe>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires>Requires a OneBot v11 client such as NapCat. Configure the client reverse WebSocket to ws://UNRAID_SERVER_IP:8085/onebot/v11/ws, or use ws://ironsbot:8080/onebot/v11/ws when both containers share a Docker network.</Requires>

  <Config Name="WebSocket Port" Target="8080" Default="8085" Mode="tcp" Description="Host port mapped to IronsBot internal port 8080." Type="Port" Display="always" Required="true" Mask="false">8085</Config>

  <Config Name="Environment" Target="ENVIRONMENT" Default="prod" Mode="" Description="NoneBot environment name." Type="Variable" Display="advanced" Required="true" Mask="false">prod</Config>
  <Config Name="Driver" Target="DRIVER" Default="~fastapi+~httpx" Mode="" Description="NoneBot driver setting." Type="Variable" Display="advanced" Required="true" Mask="false">~fastapi+~httpx</Config>
  <Config Name="Host" Target="HOST" Default="0.0.0.0" Mode="" Description="IronsBot listen host inside container." Type="Variable" Display="advanced" Required="true" Mask="false">0.0.0.0</Config>
  <Config Name="Port" Target="PORT" Default="8080" Mode="" Description="IronsBot listen port inside container." Type="Variable" Display="advanced" Required="true" Mask="false">8080</Config>
  <Config Name="Log Level" Target="LOG_LEVEL" Default="INFO" Mode="" Description="TRACE / DEBUG / INFO / WARNING / ERROR." Type="Variable" Display="advanced" Required="true" Mask="false">INFO</Config>
  <Config Name="Command Start" Target="COMMAND_START" Default="[&quot;/&quot;,&quot;&quot;]" Mode="" Description="NoneBot command prefixes." Type="Variable" Display="advanced" Required="false" Mask="false">["/",""]</Config>

  <Config Name="OneBot Access Token" Target="ONEBOT_ACCESS_TOKEN" Default="" Mode="" Description="Access token used by NapCat or another OneBot v11 client to connect to IronsBot." Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="Superusers" Target="SUPERUSERS" Default="[]" Mode="" Description="NoneBot superuser QQ list, for example [&quot;123456789&quot;]." Type="Variable" Display="always" Required="false" Mask="false">[]</Config>

  <Config Name="SeerAPI Sync URL" Target="SEERAPI_SYNC_URL" Default="https://github.com/SeerAPI/api-data/releases/download/latest/seerapi-data.sqlite" Mode="" Description="Remote SeerAPI SQLite database URL." Type="Variable" Display="advanced" Required="false" Mask="false">https://github.com/SeerAPI/api-data/releases/download/latest/seerapi-data.sqlite</Config>
  <Config Name="SeerAPI Fingerprint URL" Target="SEERAPI_FINGERPRINT_URL" Default="https://github.com/SeerAPI/api-data/releases/download/latest/seerapi-data.sqlite.sha256" Mode="" Description="Remote SeerAPI SHA256 fingerprint URL." Type="Variable" Display="advanced" Required="false" Mask="false">https://github.com/SeerAPI/api-data/releases/download/latest/seerapi-data.sqlite.sha256</Config>
  <Config Name="SeerAPI Sync Interval" Target="SEERAPI_SYNC_INTERVAL_MINUTES" Default="60" Mode="" Description="SeerAPI sync interval in minutes." Type="Variable" Display="advanced" Required="false" Mask="false">60</Config>
  <Config Name="SeerAPI Local Path" Target="SEERAPI_LOCAL_PATH" Default="seerapi-data.sqlite" Mode="" Description="Local fallback SeerAPI database path." Type="Variable" Display="advanced" Required="false" Mask="false">seerapi-data.sqlite</Config>

  <Config Name="Alias Sync URL" Target="ALIAS_SYNC_URL" Default="https://github.com/Nattsu39/ironsbot/releases/download/alias-db-latest/aliases-data.sqlite" Mode="" Description="Remote alias SQLite database URL." Type="Variable" Display="advanced" Required="false" Mask="false">https://github.com/Nattsu39/ironsbot/releases/download/alias-db-latest/aliases-data.sqlite</Config>
  <Config Name="Alias Fingerprint URL" Target="ALIAS_FINGERPRINT_URL" Default="https://github.com/Nattsu39/ironsbot/releases/download/alias-db-latest/aliases-data.sqlite.sha256" Mode="" Description="Remote alias SHA256 fingerprint URL." Type="Variable" Display="advanced" Required="false" Mask="false">https://github.com/Nattsu39/ironsbot/releases/download/alias-db-latest/aliases-data.sqlite.sha256</Config>
  <Config Name="Alias Sync Interval" Target="ALIAS_SYNC_INTERVAL_MINUTES" Default="65" Mode="" Description="Alias database sync interval in minutes." Type="Variable" Display="advanced" Required="false" Mask="false">65</Config>
  <Config Name="Alias Local Path" Target="ALIAS_LOCAL_PATH" Default="aliases-data.sqlite" Mode="" Description="Local fallback alias database path." Type="Variable" Display="advanced" Required="false" Mask="false">aliases-data.sqlite</Config>

  <Config Name="Render Cache Dir" Target="RENDER_CACHE_DIR" Default="render_cache" Mode="" Description="Rendered image cache directory." Type="Variable" Display="advanced" Required="false" Mask="false">render_cache</Config>
  <Config Name="Render Cache Max MB" Target="RENDER_CACHE_MAX_SIZE_MB" Default="200" Mode="" Description="Rendered image cache max size in MB." Type="Variable" Display="advanced" Required="false" Mask="false">200</Config>

  <Config Name="Headless Seer User ID" Target="HEADLESS_SEER_USER_ID" Default="" Mode="" Description="Optional Seer user ID / Mimi number for features that require login." Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="Headless Seer Password" Target="HEADLESS_SEER_PASSWORD" Default="" Mode="" Description="Optional MD5 password for the headless Seer login client." Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="Headless Reconnect Retries" Target="HEADLESS_SEER_RECONNECT_RETRIES" Default="3" Mode="" Description="Headless client reconnect retry count." Type="Variable" Display="advanced" Required="false" Mask="false">3</Config>

  <Config Name="Meeting Reply Number" Target="MEETING_REPLY_NUMBER" Default="" Mode="" Description="Tencent Meeting number, for example 1234567890 or 123-456-7890. The meeting URL is generated automatically." Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="Meeting Reply Template" Target="MEETING_REPLY_TEMPLATE" Default="Tencent Meeting&#10;Meeting Number: {meeting_number}&#10;Join Link: {meeting_url}" Mode="" Description="Meeting reply template. Variables: {meeting_number}, {meeting_digits}, {meeting_url}." Type="Variable" Display="advanced" Required="false" Mask="false">Tencent Meeting&#10;Meeting Number: {meeting_number}&#10;Join Link: {meeting_url}</Config>
  <Config Name="Meeting Reply Groups" Target="MEETING_REPLY_GROUPS" Default="[]" Mode="" Description="QQ groups allowed to use meeting reply, for example [123456789]." Type="Variable" Display="always" Required="false" Mask="false">[]</Config>
  <Config Name="Meeting Reply Users" Target="MEETING_REPLY_USERS" Default="[]" Mode="" Description="QQ users allowed to use meeting reply in private chat, for example [123456789]." Type="Variable" Display="always" Required="false" Mask="false">[]</Config>

  <Config Name="Event Link Reply Groups" Target="EVENT_LINK_REPLY_GROUPS" Default="[]" Mode="" Description="QQ groups allowed to query event links." Type="Variable" Display="always" Required="false" Mask="false">[]</Config>
  <Config Name="Event Link Reply Users" Target="EVENT_LINK_REPLY_USERS" Default="[]" Mode="" Description="QQ users allowed to query event links in private chat." Type="Variable" Display="always" Required="false" Mask="false">[]</Config>
  <Config Name="Event Link Send Groups" Target="EVENT_LINK_SEND_GROUPS" Default="[]" Mode="" Description="QQ groups receiving scheduled event links." Type="Variable" Display="always" Required="false" Mask="false">[]</Config>
  <Config Name="Event Link Send Users" Target="EVENT_LINK_SEND_USERS" Default="[]" Mode="" Description="QQ users receiving scheduled event links in private chat." Type="Variable" Display="always" Required="false" Mask="false">[]</Config>
  <Config Name="Event Link Send Hour" Target="EVENT_LINK_SEND_HOUR" Default="23" Mode="" Description="Scheduled event link send hour." Type="Variable" Display="advanced" Required="false" Mask="false">23</Config>
  <Config Name="Event Link Send Minute" Target="EVENT_LINK_SEND_MINUTE" Default="0" Mode="" Description="Scheduled event link send minute." Type="Variable" Display="advanced" Required="false" Mask="false">0</Config>

  <Config Name="Bilibili Monitor UID" Target="BILIBILI_MONITOR_UID" Default="1310714247" Mode="" Description="Bilibili UID to monitor." Type="Variable" Display="always" Required="false" Mask="false">1310714247</Config>
  <Config Name="Bilibili Check Interval" Target="BILIBILI_MONITOR_CHECK_INTERVAL_MINUTES" Default="5" Mode="" Description="Bilibili dynamic check interval in minutes." Type="Variable" Display="advanced" Required="false" Mask="false">5</Config>
  <Config Name="Bilibili Sleep Start Hour" Target="BILIBILI_MONITOR_SLEEP_START_HOUR" Default="23" Mode="" Description="Low-frequency check start hour." Type="Variable" Display="advanced" Required="false" Mask="false">23</Config>
  <Config Name="Bilibili Sleep End Hour" Target="BILIBILI_MONITOR_SLEEP_END_HOUR" Default="7" Mode="" Description="Low-frequency check end hour." Type="Variable" Display="advanced" Required="false" Mask="false">7</Config>
  <Config Name="Bilibili Sleep Interval" Target="BILIBILI_MONITOR_SLEEP_INTERVAL_MINUTES" Default="30" Mode="" Description="Low-frequency check interval in minutes." Type="Variable" Display="advanced" Required="false" Mask="false">30</Config>
  <Config Name="Bilibili Target Groups" Target="BILIBILI_MONITOR_TARGET_GROUP_IDS" Default="[]" Mode="" Description="QQ groups receiving Bilibili dynamic updates." Type="Variable" Display="always" Required="false" Mask="false">[]</Config>
  <Config Name="Bilibili Target Users" Target="BILIBILI_MONITOR_TARGET_USER_IDS" Default="[]" Mode="" Description="QQ users receiving Bilibili dynamic updates in private chat." Type="Variable" Display="always" Required="false" Mask="false">[]</Config>
  <Config Name="Bilibili Admin Users" Target="BILIBILI_MONITOR_ADMIN_UIDS" Default="[]" Mode="" Description="QQ users allowed to run Bilibili monitor admin commands." Type="Variable" Display="always" Required="false" Mask="false">[]</Config>
</Container>
